<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mod_info_scroll"
        android:background="@drawable/object_border_no_background"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:fillViewport="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/button_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="420.0dip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- App header: icon + title -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/mod_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/sha"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:id="@+id/mod_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dim_white" />

            </LinearLayout>

            <!-- Version -->
            <TextView
                android:id="@+id/mod_version_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_horizontal"
                android:textSize="13sp"
                android:textColor="#FFB0B0B0" />

            <!-- Developer -->
            <TextView
                android:id="@+id/mod_developer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:textSize="13sp"
                android:textColor="#FF9E9E9E" />

            <!-- Contributors & credits -->
            <TextView
                android:id="@+id/contributors_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/mod_info_contributors"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/brass_border" />

            <LinearLayout
                android:id="@+id/contributors_list"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Close -->
    <TextView
        android:id="@+id/button_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/close"
        android:textStyle="bold"
        android:textColor="@color/dim_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>